# Copy to .env (git-ignored) and fill in. Never commit real keys.

# LLM explanations. LLM_PROVIDER=auto (default): Claude if ANTHROPIC_API_KEY is set, otherwise the
# local agy CLI (its own login / subscription quota) if installed, otherwise no AI answers.
# Engine analysis and the fact panel work without any LLM.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto        # auto | anthropic | agy | fake (tests only) | none
# LLM_MODEL=               # default: claude-opus-5-5 (anthropic) / gemini-3.8-flash-high (agy)
# LLM_EFFORT=medium        # anthropic only
# AGY_PATH=agy
# LLM_CLI_TIMEOUT_S=600    # time limit for one answer from an AI CLI (agy / codex / claude)
# AI CLIs a viewer can choose in the UI (their own logins / subscription quotas):
# CODEX_PATH=codex
# CLAUDE_PATH=claude

# Engine
# ENGINE_PATH=engines/fairy-stockfish
# ENGINE_THREADS=4
# ENGINE_HASH_MB=256
# ENGINE_MOVETIME_MS=1500

# Puzzles: database directory and the puzzle engine process
# DATA_DIR=backend/data
# PUZZLE_ENGINE_THREADS=2
# PUZZLE_MOVETIME_MS=500

# Network access (set by scripts/install_service.sh for the LAN service)
# HOST=127.0.0.1
# ALLOWED_CLIENT_NETWORKS=127.0.0.0/8,::1/128,192.168.0.0/24
