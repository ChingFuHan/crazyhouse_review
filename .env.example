# Copy to .env (git-ignored) and fill in. Never commit real keys.

# LLM explanations. LLM_PROVIDER=auto (default): Claude if ANTHROPIC_API_KEY is set, otherwise the
# local agy CLI (its own login / subscription quota) if installed, otherwise no AI answers.
# Engine analysis and the fact panel work without any LLM.
ANTHROPIC_API_KEY=
# LLM_PROVIDER=auto        # auto | anthropic | agy | fake (tests only) | none
# LLM_MODEL=               # default: claude-opus-5-5 (anthropic) / gemini-3.8-flash-high (agy)
# LLM_EFFORT=medium        # anthropic only
# AGY_PATH=agy
# AGY_TIMEOUT_S=180

# Engine
# ENGINE_PATH=engines/fairy-stockfish
# ENGINE_THREADS=4
# ENGINE_HASH_MB=256
# ENGINE_MOVETIME_MS=1500
